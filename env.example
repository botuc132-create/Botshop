BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
ADMIN_IDS=YOUR_TELEGRAM_NUMERIC_ID
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_SUPABASE_SESSION_POOLER_HOST:5432/postgres?sslmode=require
LOG_LEVEL=INFO

# VietQR settings (optional; defaults are already configured in bot.py)
QR_BANK=VietinBank
QR_ACCOUNT=102886882160
QR_HOLDER=BACH CONG HIEU HUY
QR_TEMPLATE=compact
QR_SHOWINFO=false
QR_MEMO_SUFFIX=NAP

# SePay auto-approval: bot must be in this Telegram group and allowed to read new messages.
SEPAY_GROUP_ID=-1004405246932
# Recommended: set the numeric Telegram user ID of the SePay notification bot.
# If set, messages from any other bot are ignored.
SEPAY_SENDER_ID=

# URL HTTPS public của Mini App, Telegram WebApp (đặt trong service bot)
MINI_APP_URL=https://YOUR-MINI-APP-DOMAIN

# Shopyuri seller API (set the real token in Railway Variables)
SHOPYURI_API_URL=https://shopyuri.site/api/seller.php
SHOPYURI_API_TOKEN=PASTE_YOUR_SHOPYURI_TOKEN_HERE
